RDR2_WORKER28_INLINE WorkerPool28::Packet* WorkerPool28::reserve(const RecordingToken&t,VkCommandBuffer c)noexcept{
 if(t.owner_!=this||!c||t.command_!=c||!t.producer_||threadIdentity()!=t.producer_||producerId_.load(std::memory_order_relaxed)!=t.producer_)return nullptr;
 const auto expected=(t.generation_<<GenerationShift)|std::uint64_t(Phase::Open);
 if(admission_.load(std::memory_order_acquire)!=expected)return nullptr;
 if(head_==UINT64_MAX){revoked_.store(true,std::memory_order_release);return nullptr;}
 if(head_-cachedTail_==Capacity)return reserveSlow(t,c,expected);
 testPoint(1);auto compare=expected;
 if(!admission_.compare_exchange_strong(compare,expected|Active,std::memory_order_acquire,std::memory_order_relaxed))return nullptr;
 testPoint(2);return &(*packets_)[head_%Capacity];
}
RDR2_WORKER28_INLINE void WorkerPool28::commit(bool publishDraw89)noexcept{
 const auto next=++head_;committed_.store(next,std::memory_order_release);
 const auto old=admission_.fetch_and(~Active,std::memory_order_release);
 if(phaseOf(old)==Phase::Closing){std::lock_guard<std::mutex> lock(mutex_);progress_.notify_all();}
 testPoint(3);
 if(publishDraw89||next-lastPublished_>=Chunk){publish(next);lastPublished_=next;}
}
