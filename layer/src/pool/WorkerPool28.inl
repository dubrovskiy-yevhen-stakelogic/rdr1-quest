 for(unsigned k=0;k<nb;++k){auto&z=v.buffers[k];const auto&x=b[k];z.sType=x.sType;z.pNext=nullptr;z.srcAccessMask=x.srcAccessMask;z.dstAccessMask=x.dstAccessMask;z.srcQueueFamilyIndex=x.srcQueueFamilyIndex;z.dstQueueFamilyIndex=x.dstQueueFamilyIndex;z.buffer=x.buffer;z.offset=x.offset;z.size=x.size;}
 for(unsigned k=0;k<ni;++k){auto&z=v.images[k];const auto&x=i[k];z.sType=x.sType;z.pNext=nullptr;z.srcAccessMask=x.srcAccessMask;z.dstAccessMask=x.dstAccessMask;z.oldLayout=x.oldLayout;z.newLayout=x.newLayout;z.srcQueueFamilyIndex=x.srcQueueFamilyIndex;z.dstQueueFamilyIndex=x.dstQueueFamilyIndex;z.image=x.image;z.subresourceRange=x.subresourceRange;}commit();return true;}
